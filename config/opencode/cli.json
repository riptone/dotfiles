{
	"$schema": "https://opencode.ai/v2/cli.json",
	"theme": {
		"name": "pierre-dark-soft",
		"mode": "dark"
	},
	"highlights": false,
	"diffs": {
		"wrap": "none",
		"tree": true,
		"single": false
	},
	"session": {
		"sidebar": "auto",
		"scrollbar": true,
		"thinking": "hide",
		"permissions": "autoaccept",
		"image_preview": false,
		"markdown": "source"
	},
	"animations": false,
	"cursor": {
		"style": "block",
		"blinking": false
	},
	"tabs": {
		"mode": "on",
		"scope": "global",
		"layout": "horizontal",
		"indicators": "status"
	},
	"scroll": {
		"speed": 3.25
	},
	"prompt": {
		"paste": "compact",
		"image_preview": true
	},
	"terminal": {
		"title": false,
		"copy": "manual"
	},
	"debug": {
		"devtools": false,
		"turn_tokens": false,
		"timing": false
	}
}
