// Place your key bindings in this file to override the defaults
[
  {
    "key": "cmd+[Semicolon]",
    "command": "workbench.action.terminal.newWithProfile",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile",
  },
  {
    "key": "cmd+[Semicolon]",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile",
  },
  {
    "key": "ctrl+[Quote]",
    "command": "-workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile",
  },
  {
    "key": "alt+w",
    "command": "workbench.action.closeWindow",
  },
  {
    "key": "shift+cmd+w",
    "command": "-workbench.action.closeWindow",
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.nextEditor"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.previousEditor"
  },
  {
    "key": "alt+cmd+i",
    "command": "workbench.action.browser.toggleDevTools",
    "when": "browserHasUrl && !browserHasError && activeEditor == 'workbench.editor.browser'"
  },
  {
    "key": "f12",
    "command": "-workbench.action.browser.toggleDevTools",
    "when": "browserHasUrl && !browserHasError && activeEditor == 'workbench.editor.browser'"
  },
  {
    "key": "alt+cmd+n",
    "command": "latex-workshop.build",
    "when": "!config.latex-workshop.bind.altKeymap.enabled && !virtualWorkspace && editorLangId =~ /^build$|^latex$|^latex-class$|^latex-package$|^context$|^latex-expl3$|^doctex$|^rsweave$|^jlweave$|^pweave$/"
  },
  {
    "key": "alt+cmd+b",
    "command": "-latex-workshop.build",
    "when": "!config.latex-workshop.bind.altKeymap.enabled && !virtualWorkspace && editorLangId =~ /^build$|^latex$|^latex-class$|^latex-package$|^context$|^latex-expl3$|^doctex$|^rsweave$|^jlweave$|^pweave$/"
  }
]