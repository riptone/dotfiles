{
  "editor.formatOnSave": true,
  "workbench.colorTheme": "Pierre Dark Soft",
  "editor.guides.bracketPairs": true,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "git.autofetch": true,
  "json.schemas": [],
  "tabnine.experimentalAutoImports": true,
  "workbench.iconTheme": "material-icon-theme",
  "git.openRepositoryInParentFolders": "never",
  "editor.linkedEditing": true,
  "files.autoSave": "afterDelay",
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnType": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.rulers": [
      120
    ],
    "editor.semanticHighlighting.enabled": true,
  },
  "codeium.enableConfig": {
    "*": true,
    "ignore": true,
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "markdown-preview-enhanced.codeBlockTheme": "atom-material.css",
  "svelte.enable-ts-plugin": true,
  "liveServer.settings.donotVerifyTags": true,
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.startupEditor": "none",
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "window.newWindowProfile": "Default",
  "explorer.confirmPasteNative": false,
  "database-client.autoSync": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "github.copilot.nextEditSuggestions.enabled": false,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "indentRainbow.indicatorStyle": "light",
  "github.copilot.advanced": {},
  "editor.minimap.showSlider": "always",
  "editor.minimap.size": "fit",
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    "/var/folders/rs/f372sr0d7z37wcr0lywzhgz40000gn/T/postman-collections-post-response.instructions.md": true,
    "/var/folders/rs/f372sr0d7z37wcr0lywzhgz40000gn/T/postman-collections-pre-request.instructions.md": true,
    "/var/folders/rs/f372sr0d7z37wcr0lywzhgz40000gn/T/postman-folder-post-response.instructions.md": true,
    "/var/folders/rs/f372sr0d7z37wcr0lywzhgz40000gn/T/postman-folder-pre-request.instructions.md": true,
    "/var/folders/rs/f372sr0d7z37wcr0lywzhgz40000gn/T/postman-http-request-post-response.instructions.md": true,
    "/var/folders/rs/f372sr0d7z37wcr0lywzhgz40000gn/T/postman-http-request-pre-request.instructions.md": true,
  },
  "postman.mcp.notifications.postmanMCP": false,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono'",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "python.analysis.typeCheckingMode": "basic",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "git.addAICoAuthor": "off",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://tauri.app": true,
    "https://raw.githubusercontent.com": {
      "approveRequest": false,
      "approveResponse": true,
    },
  },
  "chat.mcp.gallery.enabled": true,
  "claudeCode.preferredLocation": "panel",
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true,
