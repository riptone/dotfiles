  "chat.viewSessions.orientation": "stacked",
  "workbench.browser.showInTitleBar": true,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.activityBar.location": "top",
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "window.title": " ",
  "workbench.panel.showLabels": false,
  "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "workbench.secondarySideBar.showLabels": false,
  "sessions.chatTimeline.display": "off",
  "accessibility.verbosity.sessionsChat": false,
  "workbench.experimental.modernUI": true,
  "workbench.layoutControl.enabled": false,
  "browserBridge.autoStart": false,
  "claudeCode.hideOnboarding": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
