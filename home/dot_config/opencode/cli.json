{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "autoaccept",
    "verbosity": "medium"
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "speed": 3.25
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "terminal": {
    "copy": "manual"
  },
  "debug": {
    "devtools": true,
    "turn_tokens": true
  }
}
