{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "effortLevel": "high",
  "outputStyle": "Concise",
  "autoUpdatesChannel": "latest",
  "switchModelsOnFlag": false,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_EDITOR": "true",
    "GIT_PAGER": "cat",
    "PAGER": "cat",
    "GCM_INTERACTIVE": "never",
    "npm_config_yes": "true",
    "PIP_NO_INPUT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch*)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "PowerShell(git status*)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(node --check *)",
      "Bash(node --version)",
      "Bash(npm view *)",
      "PowerShell(npm view *)",
      "Bash(npm ls *)",
      "PowerShell(npm ls *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "WebSearch",
      "mcp__dbhub"
    ],
    "deny": [
      "Read(~/.doti/**)",
      "Edit(~/.doti/**)",
      "Read(~/.config/chezmoi/key.txt)",
      "Edit(~/.config/chezmoi/key.txt)"
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/JuliusBrussee/caveman.git"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
