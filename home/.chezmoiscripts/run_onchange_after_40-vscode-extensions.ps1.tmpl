{{- if eq .chezmoi.os "windows" -}}
# Installs the extensions listed in .chezmoidata/vscode.yaml into each
# profile. Re-runs whenever that list changes; `--install-extension` skips
# ones already there. Runs after the profile files are linked, so VS Code
# finds each profile under its fixed id instead of creating a new one.
if (-not (Get-Command code -ErrorAction SilentlyContinue)) {
    Write-Host 'VS Code not installed yet - skipping extensions'
    exit 0
}
Write-Host '==> VS Code extensions (default profile)'
{{ range .vscode.extensions -}}
code --install-extension {{ . | quote }} | Out-Null
{{ end -}}
{{ range .vscode.profiles -}}
{{ $profile := .name -}}
Write-Host '==> VS Code extensions ({{ $profile }})'
{{ range .extensions -}}
code --install-extension {{ . | quote }} --profile {{ $profile | quote }} | Out-Null
{{ end -}}
{{ end -}}
{{ end -}}
