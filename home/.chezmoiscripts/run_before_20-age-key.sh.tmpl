{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Puts the age key in place before chezmoi decrypts the encrypted_ files. Runs
# before every apply, but exits immediately once the key exists, so the
# passphrase is only asked for when ~/.config/chezmoi/key.txt is missing or
# empty (first run, or someone deleted it). The key is key.txt.age in a secret
# gist on your account, itself encrypted with a passphrase. The gist is found
# through your `gh` login, so its URL is never written anywhere public -
# reading the secrets takes both that login and the passphrase.
set -eu
key={{ .chezmoi.config.age.identity | quote }}
[ -s "$key" ] && exit 0

gh auth status >/dev/null 2>&1 || gh auth login
id=$(gh api gists --paginate --jq '.[] | select(.files | has("key.txt.age")) | .id' | head -n 1)
if [ -z "$id" ]; then
  echo "No gist with key.txt.age on this gh account - see docs/secrets.md" >&2
  exit 1
fi
tmp=$(mktemp)
tmp_key="$key.tmp"
trap 'rm -f "$tmp" "$tmp_key"' EXIT
# $(...) drops jq's trailing newline; printf puts back exactly one.
printf '%s\n' "$(gh api "gists/$id" --jq '.files["key.txt.age"].content')" >"$tmp"

mkdir -p "$(dirname "$key")"
umask 077
echo "==> Decrypting the age key (your passphrase)"
# Decrypt to a temporary path first: a wrong passphrase or a cancelled prompt
# must not leave a partial key that the check at the top would accept.
if ! {{ .chezmoi.executable | quote }} age decrypt --passphrase --output "$tmp_key" "$tmp"; then
  rm -f "$tmp_key"
  exit 1
fi
mv -f "$tmp_key" "$key"
chmod 600 "$key"
{{ end -}}
